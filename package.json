{
  "name": "hexa-backend",
  "version": "0.1.0",
  "description": "NestJS backend boilerplate using hexagonal architecture (ports & adapters)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "dev:all": "./scripts/dev-all.sh",
    "frontend:start": "npm --prefix frontend run start:all",
    "frontend:build": "npm --prefix frontend run build:all",
    "frontend:test": "npm --prefix frontend run test:all",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --env-file-if-exists=.env dist/main",
    "mcp:stdio": "node --env-file-if-exists=.env dist/mcp-stdio.js",
    "db:pg:up": "docker compose --env-file .env.postgres -f compose.postgres.yml up -d",
    "db:pg:down": "docker compose --env-file .env.postgres -f compose.postgres.yml down",
    "db:pg:migrate": "node --env-file=.env.postgres scripts/migrate-sqlite-to-postgres.mjs",
    "seed": "node scripts/seed-users.mjs",
    "seed:patients": "node scripts/seed-patients.mjs",
    "admin:rescue": "node scripts/rescue-admin.mjs",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.1.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@rekog/mcp-nest": "^2.0.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "html-to-text": "^10.0.1",
    "ical-generator": "^11.1.2",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.34.1",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "timezones-ical-library": "^2.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/platform-fastify": "^12.1.3",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/html-to-text": "^9.0.4",
    "@types/luxon": "^3.7.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
