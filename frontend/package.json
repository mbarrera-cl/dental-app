{
  "name": "hexa-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:shell": "ng serve shell",
    "start:users": "ng serve users",
    "start:patients": "ng serve patients",
    "start:dashboard": "ng serve dashboard",
    "start:all": "concurrently -k -n shell,patients,users,dashboard,admin,quotes -c blue,yellow,green,magenta,cyan \"npm:start:shell\" \"npm:start:patients\" \"npm:start:users\" \"npm:start:dashboard\" \"npm:start:admin\" \"npm:start:quotes\"",
    "build": "ng build",
    "build:all": "ng build shell && ng build patients && ng build users && ng build dashboard && ng build admin && ng build quotes",
    "test": "ng test",
    "test:all": "ng test ui && ng test data-access && ng test auth && ng test shell && ng test patients && ng test users && ng test dashboard && ng test admin && ng test quotes",
    "start:admin": "ng serve admin",
    "start:quotes": "ng serve quotes"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "22.0.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@jsverse/transloco": "^8.4.0",
    "@ng-icons/core": "^32.2.0",
    "@ng-icons/lucide": "^32.2.0",
    "@spartan-ng/brain": "^1.8.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "es-module-shims": "^2.8.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "^22.2.2",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@softarc/native-federation-orchestrator": "^4.6.0",
    "@spartan-ng/cli": "^1.8.0",
    "@tailwindcss/postcss": "^4.1.12",
    "concurrently": "^10.0.6",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
