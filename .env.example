# PostgreSQL. For local Docker see compose.postgres.yml and .env.postgres.example.
DATABASE_URL=postgresql://hexa:change-me@localhost:5433/hexa
DATABASE_SSL=false

# Copia este archivo a .env y completa las claves reales.
# .env está ignorado por git; nunca subas claves al repositorio.

# Seguridad. En producción JWT_SECRET y CORS_ORIGIN son obligatorios: el
# proceso no arranca si faltan. Genera el secreto con: openssl rand -base64 48
JWT_SECRET=
CORS_ORIGIN=
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# Rate limiting global (ttl en milisegundos).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=es
DEEPGRAM_API_URL=https://api.deepgram.com

# 0 desactiva el retardo artificial entre deltas SSE.
CARO_IA_STREAM_DELAY_MS=6

# Agenda: Resend transactional email (leave empty to skip outbound email)
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
AGENDA_EMAIL_WORKER=true

# Backup automático (scripts/backup.mjs). Sin BACKUP_S3_* el dump queda en
# BACKUP_DIR; con las cinco variables se sube a almacenamiento S3-compatible
# (Backblaze B2, Cloudflare R2, AWS S3, MinIO).
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=hexa/
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=./backups
BACKUP_NOTIFY_EMAIL=
