# PostgreSQL. For local Docker see compose.postgres.yml and .env.postgres.example.
DATABASE_URL=postgresql://hexa:change-me@localhost:5433/hexa
DATABASE_SSL=false

# Copia este archivo a .env y completa las claves reales.
# .env está ignorado por git; nunca subas claves al repositorio.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=es
DEEPGRAM_API_URL=https://api.deepgram.com

# 0 desactiva el retardo artificial entre deltas SSE.
CARO_IA_STREAM_DELAY_MS=6

# Agenda: Resend transactional email (leave empty to skip outbound email)
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
AGENDA_EMAIL_WORKER=true
